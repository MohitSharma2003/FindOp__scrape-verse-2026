# FindOP frontend — environment template
# Copy to `.env` (or set in your hosting provider) and adjust per environment.

# Base URL of the FindOP backend API (no trailing slash).
# Local default matches the backend dev server.
VITE_API_URL=http://localhost:5000/api

# In production set this to the deployed backend origin, e.g.:
# VITE_API_URL=https://findop-backend.onrender.com/api
