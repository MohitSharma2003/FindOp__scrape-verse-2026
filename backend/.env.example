# FindOP backend — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env file.
# All variables are read and validated in src/config/env.ts (zod schema).

# ── Core ──────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=5000

# REQUIRED — MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/findop

# OPTIONAL — comma-separated allow-list of browser origins allowed by CORS.
# Strongly recommended in production (e.g. https://findop.vercel.app).
# Leave unset in local development to allow all origins.
CORS_ORIGIN=

# ── Bright Data ───────────────────────────────────────────────────────────────
# API token from your Bright Data account. Optional at boot; required for live
# SERP discovery / collector scraping.
BRIGHT_DATA_API_TOKEN=

# Bright Data SERP zone name
BRIGHT_DATA_SERP_ZONE=serp_api1

# Scraper Studio collector used for generic page extraction
BRIGHT_DATA_EXTRACTION_COLLECTOR_ID=
# dev | production
BRIGHT_DATA_EXTRACTION_COLLECTOR_VERSION=dev

# OPTIONAL — webhook URL for collector delivery notifications
BRIGHT_DATA_COLLECTOR_DELIVERY_WEBHOOK=

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
# Seconds between scheduler ticks (15–3600)
SCHEDULER_TICK_SECONDS=60
# Max sources scraped concurrently per tick (1–5)
SCHEDULER_MAX_CONCURRENCY=2

# ── Discovery / extraction tuning ────────────────────────────────────────────
# Candidate URLs kept per SERP query (1–20)
SERP_DISCOVERY_CANDIDATE_LIMIT=5
# Pages extracted per discovery candidate (1–10)
DISCOVERY_SEARCH_EXTRACTION_LIMIT=3
# Records enriched per batch pass (0–30)
ENRICHMENT_BATCH_SIZE=6
# Max candidates extracted during a single source scrape (1–30)
MAX_EXTRACTION_CANDIDATES=5
# Concurrent extraction requests (1–2)
EXTRACTION_CONCURRENCY=2

# ── Bright Data timeouts / polling ───────────────────────────────────────────
BRIGHT_DATA_TIMEOUT_MS=180000
BRIGHT_DATA_POLL_INTERVAL_MS=5000
BRIGHT_DATA_HEALING_TIMEOUT_MS=180000
SEARCH_REQUEST_TIMEOUT_MS=60000

# ── Self-healing ─────────────────────────────────────────────────────────────
SELF_HEALING_ENABLED=true

# ── Authentication (JWT + OTP email) ────────────────────────────────────────
# Secret used to sign JWT session tokens and hash OTP codes.
# REQUIRED in production; a dev fallback is used locally when unset.
JWT_SECRET=
# Token lifetime, e.g. "7d", "12h" or plain seconds
JWT_EXPIRES_IN=7d

# SMTP account used to deliver OTP verification emails (e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Social sign-in (OAuth) ───────────────────────────────────────────────────
# Register these redirect URIs in each provider console:
#   Google:  {BACKEND_URL}/api/auth/oauth/google/callback
#   GitHub:  {BACKEND_URL}/api/auth/oauth/github/callback
# Public URL of this backend (used to build the redirect URIs above)
BACKEND_URL=http://localhost:5000
# Public URL of the frontend (where the provider sends the browser afterwards)
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Dev/maintenance scripts only (not read by the server) ────────────────────
# Override for the Devfolio collector probe script; has a built-in default.
# DEVFOLIO_COLLECTOR_ID=
